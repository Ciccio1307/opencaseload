# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `.env.local` must never be committed (it is already in .gitignore).
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Sessione ---------------------------------------------------------------
# Stringa casuale lunga: `openssl rand -base64 32`
SESSION_SECRET=change-me-with-a-long-random-string

# --- First run --------------------------------------------------------------
# Used only until you change the password from Settings (after that the hash
# stored in the database takes over). If it is missing and no hash exists yet,
# nobody can sign in.
APP_INITIAL_PASSWORD=change-me

# --- Branding (optional) ----------------------------------------------------
# NEXT_PUBLIC_* variables are read at build time: changing them on a host like
# Netlify/Vercel requires a new deploy.
NEXT_PUBLIC_APP_NAME=Sedute
NEXT_PUBLIC_APP_SHORT_NAME=Sedute
NEXT_PUBLIC_APP_DESCRIPTION=Sessions, recovery hours and reports for your therapy practice.
NEXT_PUBLIC_THERAPIST_NAME=
NEXT_PUBLIC_LOCALE=en-GB

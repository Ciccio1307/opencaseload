# ---------------------------------------------------------------------------
# Copia questo file in `.env.local` e compila i valori.
# `.env.local` non va mai committato (è già in .gitignore).
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Sessione ---------------------------------------------------------------
# Stringa casuale lunga: `openssl rand -base64 32`
SESSION_SECRET=change-me-with-a-long-random-string

# --- Primo accesso ----------------------------------------------------------
# Usata solo finché non cambi la password da Impostazioni (poi vale l'hash
# salvato nel database). Se non è impostata e non esiste ancora un hash,
# nessuno può accedere.
APP_INITIAL_PASSWORD=change-me

# --- Branding (opzionale) ---------------------------------------------------
# Le variabili NEXT_PUBLIC_* vengono lette in fase di build: se le cambi su
# un host come Netlify/Vercel serve un nuovo deploy.
NEXT_PUBLIC_APP_NAME=Sedute
NEXT_PUBLIC_APP_SHORT_NAME=Sedute
NEXT_PUBLIC_APP_DESCRIPTION=Agenda, recuperi e resoconti per l'attività di terapia.
NEXT_PUBLIC_THERAPIST_NAME=
